# ─── API Configuration ──────────────────────────
# Next.js rewrites proxy /api/* to the backend, so this
# only matters for client-side direct calls.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─── App Configuration ─────────────────────────
NEXT_PUBLIC_APP_NAME=Booking.go
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Backend URL (used by Next.js rewrites) ─────
# Inside Docker network, the backend service is "engine"
BACKEND_URL=http://engine:8000
